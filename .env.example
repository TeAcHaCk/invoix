# ==============================================================================
# CLIENT-SIDE (bundled into the browser — never put a secret here)
# ==============================================================================
# Anything prefixed VITE_ is inlined into the JS bundle and is public by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# SERVER-SIDE ONLY (Vercel project env vars — NO VITE_ prefix)
# ==============================================================================
# Used by the functions in /api. These must never gain a VITE_ prefix, or Vite
# would inline them into the browser bundle and leak them.

# Supabase service-role key. Bypasses RLS; it is the only credential allowed to
# write profiles.plan. Find it under Supabase → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay. KEY_ID is also exposed to the browser by /api/razorpay/order, which
# is fine — the SECRET is what signs and verifies payments.
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Set when creating the webhook in Razorpay → Settings → Webhooks.
# Endpoint: https://www.invoix.app/api/razorpay/webhook   Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
